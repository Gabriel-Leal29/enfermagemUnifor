<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" Name="Enfermagem Unifor" Language="1046" Version="1.0.0.0" Manufacturer="Gabriel" UpgradeCode="78ea7f31-523c-4c6e-a60d-327c6226f987">
        <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

        <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova já está instalada." />
        <MediaTemplate EmbedCab="yes" />

        <Feature Id="ProductFeature" Title="Instalador" Level="1">
            <ComponentGroupRef Id="AppComponents" />
            <ComponentRef Id="MainExecutableShortcut" />
        </Feature>

        <Icon Id="logo_final.ico" SourceFile="logo.ico"/>
        <Property Id="ARPPRODUCTICON" Value="logo_final.ico" />
    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">
                <Directory Id="ProgramFilesFolder">
                <Directory Id="INSTALLFOLDER" Name="Enfermagem Unifor" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="Enfermagem Unifor"/>
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
        </Directory>
    </Fragment>

<Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
<Component Id="MainExecutableShortcut" Guid="7BC7E56D-1234-4567-89AB-CDEF12345678">

    <File Id="MainExe" Source="projeto_enfermagem_desktop.exe" KeyPath="no" />

    <RegistryValue Root="HKCU"
                   Key="Software\Gabriel\EnfermagemUnifor"
                   Name="installed"
                   Type="integer"
                   Value="1"
                   KeyPath="yes" />

    <Shortcut Id="StartMenuShortcut"
              Directory="ApplicationProgramsFolder"
              Name="Enfermagem Unifor"
              Target="[INSTALLFOLDER]projeto_enfermagem_desktop.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="logo_final.ico"
              Advertise="no" />

    <Shortcut Id="DesktopShortcut"
              Directory="DesktopFolder"
              Name="Enfermagem Unifor"
              Target="[INSTALLFOLDER]projeto_enfermagem_desktop.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="logo_final.ico"
              Advertise="no" />

    <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
</Component>
    </DirectoryRef>
</Fragment>
</Wix>